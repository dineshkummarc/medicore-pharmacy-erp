APP_NAME="MediCore Pharmacy"
APP_ENV=local
APP_KEY=
# NEVER enable debug in production: it exposes stack traces and config.
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL is the supported production database. Create the database first:
#   mysql -u root -p -e "CREATE DATABASE pharmacy_erp CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pharmacy_erp
DB_USERNAME=pharmacy_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true when served over HTTPS (always in production).
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Password-reset emails. "log" writes them to storage/logs locally.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# First administrator created by `php artisan db:seed`.
# Leave the password empty to have a strong random one generated and printed once.
SEED_ADMIN_NAME="Administrator"
SEED_ADMIN_EMAIL=admin@pharmacy.test
SEED_ADMIN_PASSWORD=
# Sample medicines, purchases and 60 days of sales (local environment only).
SEED_DEMO_DATA=false
